# Docker Compose上のPostgreSQL接続情報
POSTGRES_DB=portal_mock
POSTGRES_USER=portal_mock
POSTGRES_PASSWORD=portal_mock
POSTGRES_PORT=5432

# Prismaが参照するDB接続文字列。
# 開発環境（Docker Compose）: 下記のままでよい
# 将来の本番環境（Cloud SQL for PostgreSQL）: Cloud SQL Auth Proxyのソケットパスを指定した接続文字列に差し替える
DATABASE_URL="postgresql://portal_mock:portal_mock@localhost:5432/portal_mock"

# Auth.js（NextAuth）のJWT署名鍵。`openssl rand -base64 32`等で生成した値に置き換える
AUTH_SECRET="replace-with-a-random-base64-secret"

# 本番相当（NODE_ENV=production）で`next start`する場合、Auth.jsはデフォルトで
# リクエストのHostヘッダーを信用しない。Cloud Run等、信頼できるリバースプロキシ配下で
# 動作させる場合はtrueにする（開発環境の`next dev`では不要）。
AUTH_TRUST_HOST=true

# 任意。ポータルの公開URL（スキーム＋ホスト、末尾スラッシュなし）。Auth.jsのリダイレクト用途に加え、
# お知らせ公開・リマインド通知メール本文に含める詳細ページへの絶対URLの組み立てにも使う
# （`src/lib/server/announcement-notifications.ts`）。未設定時はローカル開発用に
# `http://localhost:3000`にフォールバックする。本番（Cloud Run）では`portal-mock`の公開URLを設定する。
# AUTH_URL="http://localhost:3000"

# 任意。対応期限超過の自動エスカレーション（お知らせの督促メール自動送信）を将来Cloud Scheduler
# から定期実行するための保護付きエンドポイント（`/api/cron/announcement-escalation`）の認証
# シークレット。未設定の場合、当該エンドポイントは無効化（401 Unauthorizedを返し、設定状態は開示しない）される（ローカル・検証環境では
# 未設定のままでよい。アクセス時トリガーによる自動エスカレーションは本設定に関わらず動作する）。
# 本番でCloud Schedulerを導入する際、`openssl rand -base64 32`等で生成した値をCloud Runの
# サービス環境変数（またはSecret Manager）に設定する。
# CRON_SECRET="replace-with-a-random-base64-secret"

# 任意。お知らせ・問い合わせ本文の自動翻訳（Claude API）用のAPIキー。未設定の場合、自動翻訳は
# 無効化される（お知らせは英語の手入力が必須のままになり、問い合わせは原文表示のまま「未翻訳」
# 扱いになる）。本番（Cloud Run）ではSecret Managerに登録し、サービスの環境変数として注入する
# （本番は Terraform（`infra/envs` の secret 定義）で注入する）。
# ANTHROPIC_API_KEY="sk-ant-..."

# 任意。メール送信（SMTP。`src/lib/server/mailer.ts`）。SMTP_HOST / SMTP_PORT / SMTP_USER /
# SMTP_PASS / SMTP_FROM の5つが全部そろわないとメールを送信しない（1つでも未設定なら送信しない）。
# Terraformでは未対応。クライアント環境で対応予定（現行環境では未設定）。
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="replace-with-smtp-user"
# SMTP_PASS="replace-with-smtp-password"
# SMTP_FROM="portal@example.com"

# 任意。翻訳に使うClaudeモデルID。未設定時は`claude-haiku-4-5`（低コスト・定型翻訳向け）を使う
# TRANSLATION_MODEL="claude-haiku-4-5"

# 任意。Googleアカウントでのログイン（許可ドメインのユーザーのみ）。メール+パスワード認証とは併用できる。
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET のどちらかが未設定の場合、Googleログイン自体が無効化され、
# ログイン画面に「Googleでログイン」ボタンは表示されない（ローカル・既存環境はこのままでよい）。
# Google Cloud ConsoleでOAuthクライアント（ウェブアプリケーション）を作成し、承認済みのリダイレクトURIに
# `<AUTH_URL>/api/auth/callback/google`（例: https://<公開ホスト>/api/auth/callback/google、
# ローカルは http://localhost:3000/api/auth/callback/google）を登録する。
# 本番ではSecret Managerに登録しCloud Runの環境変数として注入する。
# AUTH_GOOGLE_ID="xxxxxxxx.apps.googleusercontent.com"
# AUTH_GOOGLE_SECRET="replace-with-google-oauth-client-secret"

# Googleログインを許可するメールドメイン（カンマ区切りで複数可。前後の空白・大文字小文字は無視する）。
# 例: ALLOWED_EMAIL_DOMAINS="example.com,example.co.jp"
# 【重要】許可ドメインの検証はサーバー側（Auth.jsのsignInコールバック）で行う。Googleに渡す`hd`
# パラメータは画面上のヒントに過ぎず、検証の代わりにはならない。サブドメインは許可されない
# （`example.com`を指定しても`sub.example.com`は拒否）。メールがGoogle側で確認済み（email_verified）
# であることも必須。さらに、そのメールアドレスが既存の有効なアカウント（ApplicantUser、または
# ヘルプデスク画面ではHelpdeskStaff）として登録済みである必要がある（既定では未登録は自動作成せず
# 拒否する。ヘルプデスク担当者のみ、下記の自動作成を有効にした場合に限り自動作成できる）。
# 【未設定時の挙動】Googleログインが有効（AUTH_GOOGLE_ID/SECRET設定済み）でも、この値が未設定・空の
# 場合は全ユーザーのGoogleログインを拒否する（fail closed）。
# ALLOWED_EMAIL_DOMAINS=""

# 任意。ヘルプデスク担当者(HelpdeskStaff)のGoogleログイン時自動作成。既定はOFF（従来仕様=未登録は拒否）。
# GOOGLE_HELPDESK_AUTO_PROVISION が文字列"true"のときのみ有効（"TRUE"・"1"等は無効）。
# 有効時、自動作成の対象は「GOOGLE_HELPDESK_AUTO_PROVISION_DOMAINS ∩ ALLOWED_EMAIL_DOMAINS」の
# ドメインのみ（共通部分が空なら自動作成なし）。さらにGoogleのhd（Workspaceドメイン）がメールの
# ドメインと一致することが必須（Workspace管理外の個人Googleアカウントは対象外）。ApplicantUserに
# 同じメールがある場合は作成しない。ApplicantUser（申請者）は自動作成しない。
# 【許可ドメインを流用しない理由】ALLOWED_EMAIL_DOMAINSは申請者側・ヘルプデスク側で共通であり、
# ポータル文脈Cookie（どちらの画面からログインを開始したか）はクライアントが書き換え可能なため境界に
# ならない。「誰が日本大創側スタッフになれるか」の境界は、このドメインリストだけである。
# 自動作成された担当者はパスワード未設定（メール+パスワードでのログイン不可）。
# GOOGLE_HELPDESK_AUTO_PROVISION="true"
# GOOGLE_HELPDESK_AUTO_PROVISION_DOMAINS="example.com"
