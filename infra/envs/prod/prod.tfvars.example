# cp prod.tfvars.example prod.tfvars して編集（*.tfvars は git 管理外）
project_id  = "client-portal-prod"
name_prefix = "portal-mock-prod"

# prod は削除保護・バックアップ・PITR を有効にする
deletion_protection       = true
db_backup_enabled         = true
db_point_in_time_recovery = true
db_high_availability      = false # 要件次第で true（費用約2倍）。true にする場合は backup/PITR 有効 かつ db_tier を db-custom-* にする（shared-core 不可。docs/infra/prod-hardening.md）
db_backup_retained_count          = 14      # 自動バックアップ保持世代（既定 7）
db_transaction_log_retention_days = 7       # PITR で遡れる日数（最大 7）
db_backup_start_time              = "18:00" # UTC = JST 03:00
db_tier                   = "db-g1-small" # HA 無効の例。HA 有効なら "db-custom-2-7680" 等（専有コア）
min_instances             = 1
max_instances             = 5

manage_iam          = true
allow_public_access = true

# 手動登録が済んでから true にする
enable_translation   = false
enable_google_login  = false
# enable_smtp=true の場合は smtp_host / smtp_from が必須。先に <prefix>-smtp-user / <prefix>-smtp-pass の値を登録する
enable_smtp = false
# smtp_host = "smtp.example.com"
# smtp_port = 587
# smtp_from = "noreply@example.com"
# enable_google_login=true の場合は必須。本番はクライアントのドメインのみ
allowed_email_domains = []   # 例: ["client.example"]

# 監視（docs/infra/monitoring.md）。通知先確定後に true
# enable_monitoring = false
# alert_emails      = ["ops@example.com"]
# enable_cloudsql_down_alert = true
# enable_uptime_check        = true
# セキュリティ監視アラート（docs/infra/monitoring.md）。apply 担当・定期エクスポート SA を trusted に入れると
# Cloud Run 変更・Secret 変更・GCS IAM 変更・Cloud SQL export の通知から除外される（IAM 変更・監視無効化は常に通知）
# enable_security_alerts      = true
# security_trusted_principals = ["apply-user@example.com", "db-export@PROJECT.iam.gserviceaccount.com"]

# --- 本番化（docs/infra/prod-hardening.md）---
# 定期 SQL エクスポート（論理バックアップを GCS に保管。誤削除・インスタンス消失への備え）
db_export_enabled        = true
db_export_schedule       = "0 3 * * *"
db_export_retention_days = 30

# private IP + Direct VPC egress。要 API・権限は docs 参照。切替は Cloud SQL の再起動を伴うため
# メンテナンス時間帯に実施する。private IP と Direct VPC egress はセットで true にする
# enable_private_network     = true
# db_private_ip_enabled      = true
# cloudrun_direct_vpc_egress = true
# db_public_ip_enabled       = false  # 疎通確認後に最後に false

# 予算アラート（docs/infra/ci-and-budget.md）。請求先アカウントの権限が確認できてから true
# enable_budget_alert   = false
# billing_account_id    = "012345-6789AB-CDEF01"
# budget_monthly_amount = 10000
# budget_currency_code  = "JPY"
# budget_alert_emails   = ["ops@example.com"]
