# cp prod.tfvars.example prod.tfvars して編集（*.tfvars は git 管理外）
project_id  = "client-portal-prod"
name_prefix = "portal-mock-prod"

# prod は削除保護・バックアップ・PITR を有効にする
deletion_protection       = true
db_backup_enabled         = true
db_point_in_time_recovery = true
db_high_availability      = false # 要件次第で true（費用約2倍）
db_tier                   = "db-g1-small"
min_instances             = 1
max_instances             = 5

manage_iam          = true
allow_public_access = true

# 手動登録が済んでから true にする
enable_translation   = false
enable_google_login  = false
# enable_google_login=true の場合は必須。本番はクライアントのドメインのみ
allowed_email_domains = []   # 例: ["client.example"]

# 監視（docs/infra/monitoring.md）。通知先確定後に true
# enable_monitoring = false
# alert_emails      = ["ops@example.com"]
# enable_cloudsql_down_alert = true
# enable_uptime_check        = true

# 予算アラート（docs/infra/ci-and-budget.md）。請求先アカウントの権限が確認できてから true
# enable_budget_alert   = false
# billing_account_id    = "012345-6789AB-CDEF01"
# budget_monthly_amount = 10000
# budget_currency_code  = "JPY"
# budget_alert_emails   = ["ops@example.com"]
