# cp dev.tfvars.example dev.tfvars して編集（*.tfvars は git 管理外）
project_id  = "client-portal-dev"
name_prefix = "portal-mock-dev"

# dev は作り直しを許可し、コストを抑える
deletion_protection       = false
db_backup_enabled         = false
min_instances             = 0
max_instances             = 1

# Editor 権限のみで実施する場合は false（SA のロール付与を管理者に依頼）
manage_iam          = true
allow_public_access = true

# 手動登録が済んでから true にする
enable_translation  = false
enable_google_login = false
# enable_google_login=true の場合は必須。確認期間は自社+クライアントの複数ドメイン
allowed_email_domains = []   # 例: ["our-company.example", "client.example"]

# 監視（docs/infra/monitoring.md）。通知先確定後に true
# enable_monitoring = false
# alert_emails      = ["ops@example.com"]
# dev は db-end で夜間に DB 停止するため、停止アラートは false 推奨
# enable_cloudsql_down_alert = false
# enable_uptime_check        = true  # min_instances=0 だと5分間隔でウォーム維持になる。不要なら false

# 予算アラート（docs/infra/ci-and-budget.md）。請求先アカウントの権限が確認できてから true
# enable_budget_alert   = false
# billing_account_id    = "012345-6789AB-CDEF01"
# budget_monthly_amount = 10000
# budget_currency_code  = "JPY"
# budget_alert_emails   = ["ops@example.com"]
